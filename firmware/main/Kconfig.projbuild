menu "PS26172 configuration"

    config PS_I2S_BCK_GPIO
        int "INMP441 SCK (I2S BCK) GPIO"
        range 0 48
        default 4

    config PS_I2S_WS_GPIO
        int "INMP441 WS GPIO"
        range 0 48
        default 5

    config PS_I2S_SD_GPIO
        int "INMP441 SD (data in) GPIO"
        range 0 48
        default 6

    choice PS_I2S_FORMAT
        prompt "I2S RX framing used for capture (decided by the M1 alignment sweep)"
        default PS_I2S_FORMAT_PHILIPS
        config PS_I2S_FORMAT_PHILIPS
            bool "Philips (MSB one BCK after WS edge)"
        config PS_I2S_FORMAT_MSB
            bool "MSB-justified (MSB on the WS edge)"
    endchoice

    config PS_I2S_BCLK_INV
        bool "Invert BCK"
        default n

    config PS_CAPTURE_STREAM
        bool "Stream audio/features/posteriors over USB (data collection & evaluation builds)"
        default y
        help
            Product builds (EXP-1) turn this off: only text telemetry remains on USB, and the 32 KB
            capture TX pool shrinks to 4 slots.

    config PS_LINK_TX_RING
        int "USB link driver TX ring buffer (bytes)"
        default 16384

    config PS_KWS_ENABLE
        bool "Run the keyword model on-device"
        default y

    config PS_KWS_ARENA_BYTES
        int "TFLM tensor arena (bytes)"
        default 40960

    config PS_KWS_STRIDE_FRAMES
        int "Inference every N feature frames (DEC-11: 6 = 60 ms)"
        default 6

    config PS_KWS_AVG_N
        int "Decision: mean of the last N posteriors (§8.6 sliding window)"
        default 3

    config PS_KWS_THRESHOLD_PCT
        int "Decision threshold on the smoothed posterior (percent)"
        default 90

    config PS_KWS_REFRACTORY_MS
        int "Refractory period after a trigger (ms) — X14"
        default 2000

    config PS_INST_ACTIVE_GPIO
        int "IN-3/I-1 pipeline-active GPIO (high while the always-on pipeline works on a hop, §4.9)"
        default 16

    config PS_INST_DETECT_GPIO
        int "IN-2 detection pulse GPIO (§B5)"
        default 15

    config PS_NET_ENABLE
        bool "Wi-Fi + warm TCP streaming to the ASR server (M5)"
        default n

    config PS_WIFI_SSID
        string "Wi-Fi SSID (set in the local, gitignored firmware/sdkconfig.wifi)"
        default ""

    config PS_WIFI_PASSWORD
        string "Wi-Fi password (set in the local, gitignored firmware/sdkconfig.wifi)"
        default ""

    config PS_SERVER_HOST
        string "ASR ingest server IPv4 address"
        default "192.168.1.100"

    config PS_SERVER_PORT
        int "ASR ingest server TCP port"
        default 5005

    config PS_RING_MS
        int "Unified audio ring length (ms) — §8.3 table (1000 default; 750 with window-5-class smoothing)"
        default 1000

    config PS_READER_STACK
        int "i2s_reader task stack (bytes; runs front end + inference)"
        default 4096

    config PS_PREROLL_MS
        int "Stream starts this many ms before the trigger (§8.3: D + lead-in + jitter)"
        default 624

    config PS_STREAM_MAX_MS
        int "Device-side hard timeout for one stream (ms, §8.7)"
        default 10000

    config PS_WIFI_PS_NONE
        bool "Disable Wi-Fi modem sleep (lower, symmetric latency)"
        default y

    config PS_SAMPLE_RATE_HZ
        int "Sample rate (Hz) — frontend.json sample_rate_hz"
        default 16000

    config PS_MIC_SETTLE_MS
        int "MIC_SETTLE duration after I2S clock start (ms) — P-19 power-up blanking"
        default 300

endmenu
