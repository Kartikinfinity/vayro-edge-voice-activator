# Copy this file to firmware/sdkconfig.wifi (which is git-ignored) and fill in your own values.
# tools/idf.ps1 adds sdkconfig.wifi to the build automatically when it exists; without it the
# firmware is built without networking (keyword spotting still works, nothing is streamed).
# Use the 2.4 GHz network that the ASR server PC is on.
CONFIG_PS_NET_ENABLE=y
CONFIG_PS_WIFI_SSID="your-network-name"
CONFIG_PS_WIFI_PASSWORD="your-network-password"
# IPv4 address of the PC that runs server/ingest.py (compiled into the firmware).
CONFIG_PS_SERVER_HOST="192.168.1.100"
CONFIG_PS_SERVER_PORT=5005
