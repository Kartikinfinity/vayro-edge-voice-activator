# PS26172 firmware policy (architecture doc §B4). Only the items needed up to the
# current milestone are applied; Wi-Fi / lwIP trims are added at M5 (streaming).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# §3.7: PSRAM is DISABLED. The 256 KB claim depends on this.
# CONFIG_SPIRAM is not set

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# §B4 cache bias toward data (weights stream from flash, T-04/H-15)
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# §3.6 Arena Discipline prerequisites
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_HEAP_USE_HOOKS=y

# Binary-safe console: no colour escapes, no LF->CRLF rewriting.
# CONFIG_LOG_COLORS is not set
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
